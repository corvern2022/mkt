{
  "name": "geo-doc-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Local, API-key-free geography documentary video pipeline (Remotion + edge-tts)",
  "scripts": {
    "research": "python3 scripts/research.py",
    "audio": "python3 scripts/generate_audio.py --skip-existing",
    "qa": "python3 scripts/qa_audio.py --regen",
    "studio": "remotion studio",
    "render:tintin": "remotion render GeoDoc out/mvp_canada_tintin.mp4 --props='{\"theme\":\"tintin\",\"subtitleMode\":\"ko\"}'",
    "render:paper3d": "remotion render GeoDoc out/mvp_canada_paper3d.mp4 --props='{\"theme\":\"paper3d\",\"subtitleMode\":\"ko\"}'",
    "render:hud": "remotion render GeoDoc out/mvp_canada_hud.mp4 --props='{\"theme\":\"hud\",\"subtitleMode\":\"ko\"}'",
    "render:all": "npm run render:tintin && npm run render:paper3d && npm run render:hud",
    "build": "npm run audio && npm run qa && npm run render:all",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/patrick-hand-sc": "^5.3.0",
    "@remotion/cli": "^4.0.545",
    "d3-geo": "^3.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.545",
    "roughjs": "^4.6.6",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "^5.9.3"
  }
}
