+// 영웅별 스킬·모션 검수 화면 (개발 서버 전용, 저장 반영 없음).
+// 실제 필드 렌더러(mountField)와 실제 전투 엔진(stepFieldBattle → castFieldSkill → contentBattle.cast)을 그대로 사용한다.
+// 이 파일은 검수용 장면 구성(적 배치·기력 보류·속도 조절)과 이벤트 기록만 담당하며 게임 데이터·로직은 바꾸지 않는다.
+import './skillReview.css'
+import {mountField} from './fieldView'
+import {loadProductionRigRenderer} from './productionRigRenderer'
+import {loadApprovedFrameRenderer,FRAME_CONTRACTS,type AuthoredHero} from './approvedFrameRenderer'
+import {YELLOW_TURBAN_RECRUIT_ART} from './yellowTurbanArt'
+import {portrait} from '../ui/dom/approvedPortrait'
+import {createFieldEncounter} from '../engine/fieldEncounter'
+import {fieldSkillTiming} from '../engine/fieldSkillTiming'
+import {promotionDamage,promotionSupport} from '../engine/heroGrowth'
+import {V3_CHARACTERS,V3_CHARACTER_BY_ID,classRole,type V3Character} from '../data/v3Characters'
+import V9 from '../data/heroSkillV9.json'
+import type {FieldBattle,FieldEffect,FieldUnit,FieldRole} from '../types/fieldPoc'
+import type {RigRenderer} from '../../public/battle/approved-motion-review-v1/web/runtime'
+
+// ───────────────────────── 기본 데이터 ─────────────────────────
+type Stage=0|3|5
+type V9Hero={name:string;rarity:string;classKo:string;faction:string;basic:string;s0:string;s3:string;s5:string;note?:string}
+const V9_HEROES=(V9 as unknown as {heroes:Record<string,V9Hero>}).heroes
+const STARTERS=new Set(['m1','m3','m5'])
+const LOBBY_ART=new Set(['n_bear','n_wolf','n_boar','n_snake','n_guard','sr_munchu','sr_anryang','sr_ugil','sr_chukyung','sr_maenghoek','sr_yupyo','sr_gongsonchan','sr_wonsul','r_wangrang','r_gosun','r_iyu','r_jangryang','r_jangbo','r_chaemo','r_handang','r_jeongbo','r_yohwa','r_juchang','r_gwanpyeong','r_ijeon','r_sunugyeong','r_hahueun','c_sanwol','c_sugun','c_danyang','c_ikju','c_mudang','c_baeki','c_heochang','c_cheongju','c_wi_archer','n_cavalry','n_hopyo','c_seoryang','c_heuksan','n_pirate','n_shaman','n_deunggap','n_hyeongju'])
+const RARITY_ORDER:Record<string,number>={SSR:0,SR:1,R:2,N:3,C:4}
+const FIELD_ROLES:Record<string,FieldRole>={'방패':'tank','기병':'rogue','도사':'healer','책사':'healer','궁수':'archer'}
+const STATUS_KO:Record<string,string>={sonchaekChallenge:'도전 표식',moveSpeed:'이동속도 강화',rangeBonus:'사거리 증가',hahuyeonRivalSpeed:'공격속도 추가 강화',redirect:'피해 분담',push:'밀림',chain:'사슬 연결',accuracyDown:'명중 감소',frost:'동상',attack:'공격 강화',speed:'공격속도 강화',reduction:'피해 감소',immune:'상태이상 면역',invulnerable:'무적',crit:'치명 강화',critDamage:'치명 피해 강화',healing:'회복 증폭',burn:'화상',poison:'중독',bleed:'출혈',hot:'지속 회복',attackDown:'공격 약화',defenseDown:'방어 약화',healDown:'회복 감소',vulnerable:'받는 피해 증가',sleep:'수면',attackSlow:'공격속도 감소',stun:'기절',charm:'매혹',confusion:'혼란',slow:'둔화',taunt:'도발',armor:'방어력 강화',energyRegen:'기력 지속 회복',spin:'회전 공격',skillPower:'스킬 피해 강화',statusResistance:'상태이상 저항',tauntGuard:'도발 방어',bind:'속박',energy:'기력 회복',joMark:'조조 표식',summon:'소환',revive:'부활',critical:'치명타'}
+const statusKo=(key:string):string=>key.startsWith('immuneBlocked:')?`면역으로 막힘(${statusKo(key.slice(14))})`:STATUS_KO[key]??key
+
+const params=new URLSearchParams(location.search)
+const heroId=params.get('hero')&&V3_CHARACTER_BY_ID[params.get('hero')!]?params.get('hero')!:'yeo'
+const parseStage=(v:string|null):Stage=>v==='5'?5:v==='3'?3:0
+let stage:Stage=parseStage(params.get('star'))
+type EnemySetup='dummy'|'cluster'|'boss'
+let enemySetup:EnemySetup=(['dummy','cluster','boss'] as const).find(v=>v===params.get('enemy'))??'dummy'
+let allyHp=Number(params.get('allyHp'))||60
+if(![100,60,30].includes(allyHp))allyHp=60
+let enemyLow=params.get('enemyHp')==='low'
+let withCompanions=params.get('allies')!=='0'
+let autoSkill=params.get('auto')==='1'
+let basicOnly=false
+let skillRequested=false
+const hero=V3_CHARACTER_BY_ID[heroId]
+const v9=V9_HEROES[heroId]
+
+function fieldRoleOf(h:V3Character):FieldRole{return h.id==='songwon'?'guard':FIELD_ROLES[classRole(h.role,h.attackStyle)]??'rogue'}
+const roleAttack=(r:FieldRole)=>r==='rogue'?9:r==='tank'?7:8
+const roleHpDenominator=(id:string)=>id==='m1'?15300:id==='m5'?9450:8550
+/** 실제 엔진 snapshot()과 같은 공식으로 시전자 공격력을 계산한다. */
+const casterAttack=(u:FieldUnit)=>(u.role==='rogue'?49:u.role==='tank'?31:24)*(u.attackScale??1)
+const companionIds=()=>['m1','m3','m5'].filter(id=>id!==heroId).slice(0,2)
+
+// ───────────────────────── 재생 속도(가상 시계) ─────────────────────────
+// fieldView는 1/1.5/2배속만 지원하므로, 이 화면에서만 rAF 타임스탬프를 가상 시계로 바꿔 0.25×·0.5×·정지를 만든다.
+// 시뮬레이션 단위(1/60초)와 판정 타이밍은 그대로이며, 화면 시간이 느리게 흐를 뿐이다.
+let playRate=Number(params.get('speed'))||1
+if(![.25,.5,1].includes(playRate))playRate=1
+let pausedByUser=false
+{
+ const realRaf=window.requestAnimationFrame.bind(window)
+ let virtualNow=performance.now(),lastReal=0
+ window.requestAnimationFrame=(cb:FrameRequestCallback)=>realRaf(t=>{
+  if(t!==lastReal){if(lastReal)virtualNow+=(t-lastReal)*(pausedByUser?0:playRate);lastReal=t}
+  cb(virtualNow)
+ })
+}
+
+// ───────────────────────── 기록(이벤트 검사) ─────────────────────────
+type HitRow={amount:number;pct:number;critical:boolean;phase?:string;time:number}
+type StatusRow={key:string;targetId:string;targetName:string;ally:boolean;value?:number;duration?:number;time:number}
+type SupportRow={kind:'heal'|'shield';targetId:string;targetName:string;amount:number;pctMaxHp:number;time:number;phase?:string}
+type CastRecord={no:number;kind:'skill'|'basic';start:number;stage:Stage;attack:number;targets:Map<string,{name:string;ally:boolean;direct:HitRow[];ticks:HitRow[]}>;statuses:StatusRow[];support:SupportRow[];summons:Set<string>}
+let records:CastRecord[]=[]
+let castNo=0
+const meter=new Map<string,{name:string;damage:number;healing:number;shield:number;casts:number}>()
+let dirty=true
+
+function ownerOf(state:FieldBattle,sourceId:string|undefined){
+ if(!sourceId)return undefined
+ const u=state.units.find(v=>v.id===sourceId)
+ return u?.abilitySummonOwner??sourceId
+}
+function newRecord(kind:'skill'|'basic',state:FieldBattle){
+ const caster=state.units.find(u=>u.id===heroId)
+ const r:CastRecord={no:++castNo,kind,start:state.time,stage,attack:caster?casterAttack(caster):1,targets:new Map(),statuses:[],support:[],summons:new Set()}
+ records.unshift(r)
+ // 평타 기록은 최근 것만, 스킬 기록은 최근 8회까지 유지
+ const skills=records.filter(x=>x.kind==='skill').slice(0,8),basics=records.filter(x=>x.kind==='basic').slice(0,14)
+ records=records.filter(x=>skills.includes(x)||basics.includes(x))
+ dirty=true
+ return r
+}
+function onActions(actions:readonly {unit:FieldUnit;skill:boolean}[],state:FieldBattle){
+ for(const {unit,skill} of actions){
+  if(unit.ally&&!unit.abilitySummonOwner){const m=meterRow(state,unit.id);if(skill)m.casts++}
+  if(unit.id!==heroId)continue
+  if(skill){newRecord('skill',state);skillRequested=false}
+  else newRecord('basic',state)
+ }
+}
+function meterRow(state:FieldBattle,id:string){
+ let row=meter.get(id)
+ if(!row){const u=state.units.find(v=>v.id===id);row={name:V3_CHARACTER_BY_ID[id]?.name??u?.name??id,damage:0,healing:0,shield:0,casts:0};meter.set(id,row)}
+ return row
+}
+function onEffects(effects:readonly FieldEffect[],state:FieldBattle){
+ for(const e of effects){
+  const owner=ownerOf(state,e.sourceId)
+  const ownerUnit=state.units.find(u=>u.id===owner)
+  // 피해 미터: 아군(소환수 포함) 누적
+  if(ownerUnit?.ally&&owner){
+   const m=meterRow(state,owner)
+   const target=state.units.find(u=>u.id===e.targetId)
+   if((e.kind==='hit'||e.kind==='shot')&&target&&!target.ally)m.damage+=e.amount
+   if(e.kind==='heal')m.healing+=e.amount
+   if(e.kind==='shield')m.shield+=e.amount
+   dirty=true
+  }
+  if(owner!==heroId)continue
+  if(e.sourceId&&e.sourceId!==heroId)records.find(r=>r.kind==='skill')?.summons.add(e.sourceId)
+  const isSkill=e.skill||e.phase==='dot'||e.phase==='zoneTick'
+  let rec=records.find(r=>r.kind===(isSkill?'skill':'basic'))
+  if(!rec||(rec.kind==='basic'&&state.time-rec.start>2.5)||(rec.kind==='skill'&&state.time-rec.start>20))rec=newRecord(isSkill?'skill':'basic',state)
+  const target=state.units.find(u=>u.id===e.targetId)
+  const targetName=target?(V3_CHARACTER_BY_ID[target.appearanceId??target.id]&&target.ally?V3_CHARACTER_BY_ID[target.appearanceId??target.id].name:target.name):(e.targetId??'?')
+  if(e.kind==='hit'||e.kind==='shot'){
+   if(!target)continue
+   let t=rec.targets.get(target.id)
+   if(!t){t={name:targetName,ally:target.ally,direct:[],ticks:[]};rec.targets.set(target.id,t)}
+   const row={amount:e.amount,pct:e.amount/rec.attack*100,critical:!!e.critical,phase:e.phase,time:state.time}
+   if(e.phase==='dot'||e.phase==='zoneTick')t.ticks.push(row);else t.direct.push(row)
+  }else if(e.kind==='heal'||e.kind==='shield'){
+   rec.support.push({kind:e.kind,targetId:e.targetId??'',targetName,amount:e.amount,pctMaxHp:target?e.amount/target.maxHp*100:0,time:state.time,phase:e.phase??e.label})
+  }else if(e.kind==='buff'||e.kind==='debuff'){
+   const key=e.label??'?'
+   const fx=target?.skillState?.effects?.find(x=>x.key===key&&x.source===e.sourceId&&x.until>state.time)
+   rec.statuses.push({key,targetId:e.targetId??'',targetName,ally:!!target?.ally,value:fx?.value??(key==='energy'?e.amount:undefined),duration:fx?fx.until-state.time:undefined,time:state.time})
+  }
+  dirty=true
+ }
+}
+
+// ───────────────────────── 기대값(spec) — 있으면 사용 ─────────────────────────
+// src/data/heroSkillSpec.v9.json(별도 패치)이 있으면 자동으로 읽는다. 없으면 실제 결과만 보여 준다.
+type SpecEffect={kind:string;coef?:number;perTick?:number;unit?:string;targets?:number|null;select?:string;side?:string;growth?:boolean|'either';status?:string;statusAny?:string[];value?:number;duration?:number|null;ticks?:number;hitsPerTarget?:number;pulses?:number;range?:[number,number];accept?:number[];ambiguous?:boolean;observable?:boolean;absent?:boolean;probe?:boolean;aura?:boolean;maxHpBonus?:boolean;startEnergy?:boolean;note?:string;amount?:number;count?:number;attackCoef?:number}
