+// ---------------------------------------------------------------- public API
+export function checkHeroStage(spec,heroId,stage){
+ const h=spec.heroes[heroId],st=h.stages[stage]
+ const cases=[]
+ for(const kase of st.cases){
+  const allUnobs=kase.expect.every(e=>e.observable===false)
