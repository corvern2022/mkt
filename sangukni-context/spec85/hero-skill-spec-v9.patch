+  heroStages:skill.length,heroStagePass:skill.filter(x=>x.status==='PASS').length,heroStageFail:skill.filter(x=>x.status==='FAIL').length,
+  checks:skill.reduce((s,x)=>s+x.checks,0),checksPassed:skill.reduce((s,x)=>s+x.passed,0),checksFailed:skill.reduce((s,x)=>s+x.failed,0),
+  unchecked:skill.reduce((s,x)=>s+x.cases.reduce((a,c)=>a+c.unchecked.length,0),0),
+  heroesAllStagesPass:ids.filter(id=>skill.filter(x=>x.heroId===id).every(x=>x.status==='PASS')).length,
+  critChecks:crit.length,critPass:crit.filter(x=>x.status==='PASS').length,
+  textStages:text.length*3,textPass:text.reduce((s,x)=>s+x.stages.filter(y=>y.status==='PASS').length,0),
+ }
+ return {specVersion:spec.version,specSource:spec.source,totals,skill,crit,text}
+}
