+  let r
+  try{const run=runCase(spec,heroId,stage,kase);r=checkCase(spec,run)}
+  catch(err){r={results:[{ok:false,label:'harness/runtime error',expected:'정상 실행',got:String(err?.stack??err).split('\n').slice(0,3).join(' | ')}],warnings:[],unchecked:[]}}
+  cases.push({id:kase.id,status:r.results.every(x=>x.ok)?'PASS':'FAIL',...r})
+ }
+ const checks=cases.flatMap(c=>c.results)
+ const failed=checks.filter(x=>!x.ok)
+ return {heroId,name:h.name,rarity:h.rarity,stage,status:failed.length?'FAIL':'PASS',checks:checks.length,passed:checks.length-failed.length,failed:failed.length,cases,
