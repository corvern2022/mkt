+/** Displayed 0/3/5 description numbers must equal the v9 text numbers. */
+export function checkDescriptionText(spec,heroId){
+ const h=spec.heroes[heroId],tpl=V3_CHARACTER_BY_ID[heroId]
+ const shown={0:tpl?.active??'',3:tpl?.passive??'',5:tpl?.star5??''}
+ const nums=t=>(String(t).replace(/^[^:：]{1,24}[:：]\s*/,'').match(/\d+(?:\.\d+)?/g)??[]).map(Number)
+ const out=[]
+ for(const s of [0,3,5]){
+  const want=h.textNumbers[s].map(Number),got=nums(shown[s])
+  const missing=want.filter(n=>!got.includes(n)),extra=got.filter(n=>!want.includes(n))
+  out.push({stage:s,status:missing.length||extra.length?'FAIL':'PASS',expectedText:h.text[s],shownText:shown[s],missing,extra,
+   message:missing.length||extra.length?`${heroId} ★${s} 설명문: expected 숫자 [${want.join(', ')}], got [${got.join(', ')}]${missing.length?` (누락 ${missing.join(',')})`:''}${extra.length?` (불필요 ${extra.join(',')})`:''}`:null})
+ }
+ return {heroId,name:h.name,stages:out,status:out.every(x=>x.status==='PASS')?'PASS':'FAIL'}
+}
+
+export function runAll(spec=loadSpec(),{heroes}={}){
+ const ids=heroes??Object.keys(spec.heroes)
+ const skill=[],crit=[],text=[]
+ for(const id of ids){for(const s of [0,3,5])skill.push(checkHeroStage(spec,id,s));const c=checkSkillCrit(spec,id);if(c)crit.push(c);text.push(checkDescriptionText(spec,id))}
