+/** E1: skill direct damage can crit (DoT/zone ticks excluded). */
+export function checkSkillCrit(spec,heroId){
+ const kase=spec.heroes[heroId].stages[0].cases.find(c=>c.id==='base')
+ if(!kase||!kase.expect.some(e=>e.kind==='damage'&&e.observable!==false&&e.source!=='basic-sweep'&&(!e.unit||e.unit==='atk')))return null
+ try{
+  const a=runCase(spec,heroId,0,kase),b=runCase(spec,heroId,0,kase,{crit:true})
+  const sum=(r,k)=>classifyDamage(r)[k].reduce((s,e)=>s+e.value,0)
+  const d0=sum(a,'direct'),d1=sum(b,'direct'),z0=sum(a,'zone')+sum(a,'dot'),z1=sum(b,'zone')+sum(b,'dot')
+  const msgs=[]
+  if(!(d0>0))msgs.push(`${heroId} E1: 직접 피해 없음`)
+  else if(!near(d1/d0,2,spec.tolerance.coefRelative))msgs.push(`${heroId} E1: expected 스킬 직접 피해 ×2 (치명타 100%/피해 200%), got ×${fmt(d1/d0)}`)
+  if(z0>0&&!near(z1/z0,1,spec.tolerance.coefRelative))msgs.push(`${heroId} E1: expected 지속 피해(장판·화상·독) ×1, got ×${fmt(z1/z0)}`)
+  return {heroId,status:msgs.length?'FAIL':'PASS',directRatio:d0?d1/d0:null,tickRatio:z0?z1/z0:null,messages:msgs}
+ }catch(err){return {heroId,status:'FAIL',messages:[`${heroId} E1: error ${err}`]}}
+}
